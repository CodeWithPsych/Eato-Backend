# ── Server ────────────────────────────────────────────────────
PORT=8000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017

# ── CORS ──────────────────────────────────────────────────────
CORS_ORIGIN=*

# ── Cloudinary ────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Owner JWT ─────────────────────────────────────────────────
OWNER_ACCESS_SECRET=replace_with_64_char_random_hex_owner_access
OWNER_REFRESH_SECRET=replace_with_64_char_random_hex_owner_refresh
OWNER_ACCESS_EXPIRES_IN=12h
OWNER_REFRESH_EXPIRES_IN=30d

# ── Chef JWT ──────────────────────────────────────────────────
CHEF_ACCESS_SECRET=replace_with_64_char_random_hex_chef_access
CHEF_REFRESH_SECRET=replace_with_64_char_random_hex_chef_refresh
CHEF_ACCESS_EXPIRES_IN=12h
CHEF_REFRESH_EXPIRES_IN=7d

# ── Email (resend) ────────────────────────────────────────
SMTP_PASS=your_app_password_here
